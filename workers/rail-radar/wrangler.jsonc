{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rail-radar-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true

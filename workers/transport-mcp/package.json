{
  "name": "transport-mcp-worker",
  "version": "1.0.0",
  "description": "TDX Transport MCP Server — Cloudflare Worker (Hono + MCP SDK) + Docker Node.js deployment",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "dev:node": "tsx watch src/node-server.ts",
    "start": "node dist/node-server.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "tsx tests/test-mcp.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}

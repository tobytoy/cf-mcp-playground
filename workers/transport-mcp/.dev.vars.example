# ──────────────────────────────────────────────────────────────
# Cloudflare Workers Local Development Environment Variables
# Copy this file to .dev.vars and fill in your values.
# .dev.vars is gitignored — NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────

# Access Control & Roles (Dev / VIP / Guest)
DEV_SECRET_KEY=your_dev_secret_key_here
VIP_SECRET_KEYS=your_vip_demo_user_key,another_vip_key

# TDX Transport Data eXchange (交通部 TDX) — https://tdx.transportdata.tw
TDX_CLIENT_ID=your_tdx_client_id_here
TDX_CLIENT_SECRET=your_tdx_client_secret_here

# Redis Cache (for Docker / Node.js deployment only)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

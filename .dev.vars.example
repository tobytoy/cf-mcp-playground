# Cloudflare Workers Local Development Environment Variables
# Copy this file to .dev.vars for local testing with `npm run dev:worker`

# TDX (Transport Data eXchange) OAuth Credentials
TDX_CLIENT_ID=your_tdx_client_id_here
TDX_CLIENT_SECRET=your_tdx_client_secret_here

# Access Control & Roles (Dev / VIP / Guest)
DEV_SECRET_KEY=dev_local_secret_key
VIP_SECRET_KEYS=vip_friends,vip_demo_user,vip_tester01

# Environment
ENVIRONMENT=development
